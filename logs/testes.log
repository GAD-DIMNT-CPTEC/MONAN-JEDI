Na etapa do configure, você deverá encontrar um erro relacionado ao VerticalInterpolation, se solucionado erro no module_sprayHFs e quando solucionado no module_cu_gf_monan -> No MONAN foram adicionadas algumas funcionalidades e modulos a mais que o MPAS não tem.   ## Solução para os modules adicionais do MONAN  Editar: vi /lustre/projetos/monan_das/rodrigo.braz/src/spack-stack/MONAN-JEDI/mpas/src/core_atmosphere/CMakeLists.txt  Adicionar  "mpas_vertical_interpolation.F" em:  # diagnostics/ set(ATMOSPHERE_CORE_DIAGNOSTIC_SOURCES     mpas_atm_diagnostic_template.F     mpas_atm_diagnostics_manager.F     mpas_atm_diagnostics_utils.F     mpas_cloud_diagnostics.F     mpas_convective_diagnostics.F     mpas_isobaric_diagnostics.F     mpas_pv_diagnostics.F     mpas_soundings.F     mpas_vertical_interpolation.F )   Adicionar  "module_sprayHFs.F90" em:  set(ATMOSPHERE_CORE_PHYSICS_MMM_SOURCES     bl_gwdo.F90     bl_ysu.F90     cu_ntiedtke.F90     module_libmassv.F90     mp_wsm6.F90     mp_wsm6_effectRad.F90     bl_mynn.F90     bl_mynn_subroutines.F90     mp_radar.F90     mynn_shared.F90     sf_mynn.F90     sf_sfclayrev.F90     module_sprayHFs.F90 )  Adicionar  "set inteiro do physics_monan" em:  # physics/physics_monan/ set(ATMOSPHERE_CORE_PHYSICS_MONAN_SOURCES     modConstants.F     modGate.F     modHenrysLawCts.F     modVector.F     module_bl_mixingscalars.F     module_cu_gf.monan.F     module_mp_cldfra_cb.F ) list(TRANSFORM ATMOSPHERE_CORE_PHYSICS_MONAN_SOURCES PREPEND physics/physics_monan/)  (...) 
Adicionar ${ATMOSPHERE_CORE_PHYSICS_MONAN_SOURCES} em add_library   add_library(core_atmosphere ${ATMOSPHERE_CORE_SOURCES}              ${ATMOSPHERE_CORE_PHYSICS_NOAMP_SRC_SOURCES}              ${ATMOSPHERE_CORE_PHYSICS_SOURCES}              ${ATMOSPHERE_CORE_PHYSICS_MMM_SOURCES}              ${ATMOSPHERE_CORE_PHYSICS_MONAN_SOURCES} (...) 
