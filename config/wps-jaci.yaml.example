# Merge this section into config/jaci.yaml before building WPS.
#
# Do not guess configure_option. Run ./configure under the loaded JACI stack,
# identify the serial option with GRIB2 support, record its menu number here,
# then run scripts/monan-jedi-wps.sh.

wps:
  enabled: true
  repo: https://github.com/wrf-model/WPS.git
  ref: master
  version: 4.6.0

  # Example only. Replace with the menu choice observed on JACI.
  configure_option: ""
  compile_target: ungrib

  # Empty paths are derived from project.root and install.root.
  source_dir:
  install_dir:

  # Leave empty to attempt `spack location -i jasper` in the loaded stack.
  jasper_root:

  ungrib_name: ungrib.exe
  link_grib_name: link_grib.csh
